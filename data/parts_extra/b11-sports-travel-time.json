    "ipa": "ə ˌbɪz.i striːt"
   },
   {
    "en": "in a small town",
    "zh": "在一個小城鎮",
    "ipa": "ɪn ə ˌsmɔːl ˈtaʊn"
   }
  ],
  "sentences": [
   {
    "en": "The museum is next to the big park in the city centre.",
    "zh": "博物館就在市中心那座大公園旁邊。"
   },
   {
    "en": "There is a small supermarket at the end of our street.",
    "zh": "我們街道的盡頭有一家小超市。"
   },
   {
    "en": "We took the lift up to the gallery on the top floor.",
    "zh": "我們搭電梯上到頂樓的美術館。"
   },
   {
    "en": "The old castle is a popular place for school trips.",
    "zh": "那座古老的城堡是學校校外教學的熱門地點。"
   },
   {
    "en": "Please wait near the entrance until the bell rings.",
    "zh": "請在入口附近等到鈴聲響。"
   },
   {
    "en": "My father works in an office near the harbour.",
    "zh": "我爸爸在港口附近的一間辦公室上班。"
   },
   {
    "en": "We ate lunch in the cafe under the old church.",
    "zh": "我們在老教堂下面的咖啡館吃午餐。"
   },
   {
    "en": "The circus is in the town square until Sunday.",
    "zh": "馬戲團在鎮上的廣場表演到星期日。"
   },
   {
    "en": "Her bedroom is on the second floor above the kitchen.",
    "zh": "她的臥室在三樓，就在廚房上面。"
   },
   {
    "en": "The village has a tiny shop and a post office.",
    "zh": "那個村莊有一家小店和一家郵局。"
   },
   {
    "en": "We bought a map at the tourist office near the port.",
    "zh": "我們在港口附近的旅遊服務中心買了地圖。"
   },
   {
    "en": "Tourists love the colourful markets in the old city.",
    "zh": "觀光客很喜歡老城區色彩繽紛的市集。"
   },
   {
    "en": "The hospital is opposite the park, next to the church.",
    "zh": "醫院在公園對面，緊鄰著教堂。"
   },
   {
    "en": "We watched the match on a tennis court behind the school.",
    "zh": "我們在學校後面的網球場看比賽。"
   }
  ],
  "tips": [
   "博物館、車站、公園這種公共場所，前面幾乎都要加定冠詞。",
   "衣櫥和廁所是兩個不同的詞，千萬不要弄混，廁所另有說法。",
   "港口、美術館、戲院這幾個英式單字字母比較多，打字時特別容易漏字。"
  ]
