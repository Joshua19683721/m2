    "en": "She drives a small blue car to work every day.",
    "zh": "她每天開一輛藍色小車上班。"
   },
   {
    "en": "Every passenger must show a ticket to the driver.",
    "zh": "每位乘客都必須向司機出示車票。"
   },
   {
    "en": "The road was closed because of a big crash.",
    "zh": "因為發生嚴重車禍，馬路封閉了。"
   },
   {
    "en": "We hired a car at the station near the hotel.",
    "zh": "我們在車站附近租了一輛車。"
   },
   {
    "en": "Stop the car here, please. I want to take a photo.",
    "zh": "請在這裡停車，我想拍一張照片。"
   },
   {
    "en": "The new tram stops near the shopping centre every ten minutes.",
    "zh": "新電車每十分鐘在購物中心附近停一站。"
   },
   {
    "en": "Children under five travel free on the bus.",
    "zh": "五歲以下的兒童搭公車免費。"
   },
   {
    "en": "Our journey by ship was long but very comfortable.",
    "zh": "我們搭船的旅程很久，但很舒服。"
   }
