  "sentences": [
   {
    "en": "She wears a black jacket and a wool scarf to work.",
    "zh": "她上班穿著黑色夾克和羊毛圍巾。"
   },
   {
    "en": "My new jeans are too long, so I wear my black trousers.",
    "zh": "我新買的牛仔褲太長了，所以我穿黑色長褲。"
   },
   {
    "en": "It is cold today, so put on your raincoat and a hat.",
    "zh": "今天很冷，所以穿上雨衣和帽子。"
   },
   {
    "en": "I put my wet gloves and scarf near the heater.",
    "zh": "我把溼手套和圍巾放在暖氣旁邊晾乾。"
   },
   {
    "en": "Please wear a swimming costume, because we are going to the pool.",
    "zh": "請穿泳衣，因為我們要去游泳池。"
   },
   {
    "en": "The shop sells T-shirts, socks and hats at low prices.",
    "zh": "這家店以低價販賣圓領衫、襪子和帽子。"
   },
   {
    "en": "My little brother needs a new pair of shoes for school.",
    "zh": "我弟弟上學需要一雙新鞋。"
   },
   {
    "en": "She is wearing a beautiful necklace and a gold ring.",
    "zh": "她戴著一條美麗的項鍊和一枚金戒指。"
   },
   {
    "en": "Do not forget your wallet and your glasses when you leave.",
    "zh": "離開的時候別忘了帶皮夾和眼鏡。"
   },
   {
    "en": "This coat is made of soft wool, so it is very warm.",
    "zh": "這件外套是柔軟的羊毛做的，所以很暖和。"
   },
   {
    "en": "We wear a blue uniform every Monday at school.",
    "zh": "我們每週一在學校都穿藍色制服。"
   },
   {
    "en": "Take off your wet shoes before you walk on the clean floor.",
    "zh": "在走過乾淨的地板之前，先把濕鞋子脫掉。"
   },
   {
    "en": "He wears a leather belt with his black jeans and a white shirt.",
    "zh": "他穿黑色牛仔褲和白色襯衫，腰上繫著皮帶。"
   },
   {
    "en": "My grandmother always wears glasses and a simple gold ring.",
    "zh": "我奶奶總是戴著眼鏡和一枚素面的金戒指。"
   }
  ],
  "tips": [
   "褲子類名詞沒有單數形式：jeans、shorts、trousers、tights 永遠是複數，要配「一雙」「一條」才自然。",
   "材質名詞（leather、wool、fur、cotton、silk）前面不加冠詞，要說 a leather belt、a wool jumper，不是 a leather。",
   "put on 是「穿上」、take off 是「脫下」，wear 是「一直穿著」的狀態，三個詞的分界要練熟。"
  ]
