  "sentences": [
   {
    "en": "My pet cat sleeps on the sofa every afternoon.",
    "zh": "我的寵物貓每天下午都在沙發上睡覺。"
   },
   {
    "en": "That clever dolphin is a strange sea creature.",
    "zh": "那隻聰明的海豚是一種奇怪的海洋生物。"
   },
   {
    "en": "Ants and flies are tiny insects in the garden.",
    "zh": "螞蟻和蒼蠅是花園裡的小昆蟲。"
   },
   {
    "en": "My puppy barked at a snake in the long grass.",
    "zh": "我的小狗對草叢裡的一條蛇叫了起來。"
   },
   {
    "en": "We saw two elephants and three giraffes at the zoo today.",
    "zh": "我們今天在動物園看到兩隻大象和三隻長頸鹿。"
   },
   {
    "en": "Rabbits and mice are afraid of the big cat.",
    "zh": "兔子跟老鼠都害怕那隻大貓。"
   },
   {
    "en": "The tortoise moves slowly, but the rabbit moves fast.",
    "zh": "烏龜移動得很慢，但兔子跑得很快。"
   },
   {
    "en": "Whales and dolphins live in the cold sea.",
    "zh": "鯨魚和海豚住在寒冷的海裡。"
   },
   {
    "en": "The parrot can speak and the monkey is funny.",
    "zh": "那隻鸚鵡會說話，而猴子很滑稽。"
   },
   {
    "en": "Bees and butterflies are busy in the warm summer garden.",
    "zh": "蜜蜂和蝴蝶在溫暖的夏日花園裡忙碌。"
   },
   {
    "en": "My uncle keeps three dogs, a cat and a hamster.",
    "zh": "我叔叔養了三隻狗、一隻貓和一隻倉鼠。"
   },
   {
    "en": "An eagle has sharp eyes and very strong wings.",
    "zh": "老鷹有銳利的眼睛和非常強壯的翅膀。"
   },
   {
    "en": "Crocodiles and snakes are dangerous animals near the river.",
    "zh": "鱷魚和蛇是河邊很危險的動物。"
   },
   {
    "en": "The little cub stays close to the big gorilla.",
    "zh": "那隻小幼獸一直待在高大猩猩的身邊。"
   }
  ],
  "tips": [
   "動物名詞的複數很多不規則：老鼠的複數是 mice，綿羊的 sheep 複數不分單複數，魚的 fish 也是一樣，要特別記。",
   "練習時把「動物加集合名詞」整組背起來，例如 a herd of cows、a flock of birds、a pride of lions，才不會講錯。",
   "拼字時特別注意字節多的詞，butterfly、dinosaur、elephant 都是很容易打錯的一類。"
  ]
