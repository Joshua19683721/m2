   },
   {
    "en": "Good luck with your exam! See you tomorrow, bye.",
    "zh": "祝你考試順利！明天見，掰掰。"
   },
   {
    "en": "Happy birthday! Have a nice day at the party.",
    "zh": "生日快樂！祝你在派對上玩得愉快。"
   },
   {
    "en": "See you later. Take care and say congratulations to your sister.",
    "zh": "待會見，保重，也幫我跟你妹妹說聲恭喜。"
   },
   {
    "en": "This way, please. Follow me and sit down.",
    "zh": "請走這邊，跟我來坐下。"
   },
   {
    "en": "Long time no see! How are you these days?",
    "zh": "好久不見！最近過得怎麼樣？"
   },
   {
    "en": "No worries. Everything is all right now, honestly.",
    "zh": "別擔心，老實說一切都沒問題了。"
   }
